#!/bin/bash

# =============================================================================
# CPU Turbo Boost Toggle Script
# Toggles AMD/Intel CPU turbo boost via /sys/devices/system/cpu/cpufreq/boost
# and sends a desktop notification.
# =============================================================================

BOOST_FILE="/sys/devices/system/cpu/cpufreq/boost"

if [ ! -f "$BOOST_FILE" ]; then
    notify-send -a "CPU Boost" -u critical "CPU Boost Error" "Boost interface file not found: $BOOST_FILE"
    exit 1
fi

CURRENT_STATE=$(cat "$BOOST_FILE" 2>/dev/null)

if [ "$CURRENT_STATE" = "1" ]; then
    if echo 0 > "$BOOST_FILE" 2>/dev/null; then
        notify-send -a "CPU Boost" -h string:synchrbonous:cpuboost -i "speedometer-slow" "CPU Turbo Boost" "Disabled (Power Save / Cooler)"
    else
        notify-send -a "CPU Boost" -u critical "CPU Boost Error" "Permission denied writing to $BOOST_FILE.\nCheck /etc/tmpfiles.d/cpuboost.conf"
        exit 1
    fi
elif [ "$CURRENT_STATE" = "0" ]; then
    if echo 1 > "$BOOST_FILE" 2>/dev/null; then
        notify-send -a "CPU Boost" -h string:synchronous:cpuboost -i "speedometer" "CPU Turbo Boost" "Enabled (Max Performance)"
    else
        notify-send -a "CPU Boost" -u critical "CPU Boost Error" "Permission denied writing to $BOOST_FILE.\nCheck /etc/tmpfiles.d/cpuboost.conf"
        exit 1
    fi
else
    notify-send -a "CPU Boost" -u critical "CPU Boost Error" "Unexpected boost state: '$CURRENT_STATE'"
    exit 1
fi
