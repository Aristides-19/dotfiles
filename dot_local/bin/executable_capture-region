#!/bin/bash

# capture-region: Smart region/window/monitor selection using slurp + hyprpicker + hyprctl
# Based on Omarchy's region picking script.
#
# Usage:
#   capture-region [MODE] [OPTIONS]
#
# Modes:
#   smart           Freeform selection with window/monitor bounds snapping for bare clicks (default).
#   region          Freeform region selection using slurp.
#   windows         Snap selection to active workspace window or monitor rectangles.
#   fullscreen      Select full bounds of the currently focused monitor without interaction.
#
# Options:
#   --match-monitor Output "monitor:NAME" if selection exactly matches a monitor's geometry.
#   --take-fullscreen Dismiss active slurp instance and select the focused monitor.

FULLSCREEN_MARKER="${XDG_RUNTIME_DIR:-/tmp}/capture-region-fullscreen"

if [[ ${1:-} == "--take-fullscreen" ]]; then
  pgrep -x slurp >/dev/null || exit 0
  touch "$FULLSCREEN_MARKER"
  pkill -x slurp
  exit 0
fi

MODE="smart"
MATCH_MONITOR=false

for arg in "$@"; do
  case $arg in
  --match-monitor) MATCH_MONITOR=true ;;
  region|windows|smart|fullscreen) MODE=$arg ;;
  esac
done

# Accounting for portrait/transformed displays
JQ_MONITOR_GEO='
  def format_geo:
    .x as $x | .y as $y |
    (.width / .scale | floor) as $w |
    (.height / .scale | floor) as $h |
    .transform as $t |
    if $t == 1 or $t == 3 then
      "\($x),\($y) \($h)x\($w)"
    else
      "\($x),\($y) \($w)x\($h)"
    end;
'

get_rectangles() {
  local active_workspace
  active_workspace=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .activeWorkspace.id')
  hyprctl monitors -j | jq -r --arg ws "$active_workspace" "${JQ_MONITOR_GEO} .[] | select(.activeWorkspace.id == (\$ws | tonumber)) | format_geo"
  hyprctl clients -j | jq -r --arg ws "$active_workspace" '.[] | select(.workspace.id == ($ws | tonumber)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

focused_monitor_geo() {
  hyprctl monitors -j | jq -r "${JQ_MONITOR_GEO} .[] | select(.focused == true) | format_geo"
}

pick() {
  local selection
  rm -f "$FULLSCREEN_MARKER"
  selection=$(slurp -b "000000B0" -s "00000000" -B "000000B0" -c "89b4faFF" -w 2 "$@" 2>/dev/null)

  if [[ -z $selection && -e $FULLSCREEN_MARKER ]]; then
    rm -f "$FULLSCREEN_MARKER"
    selection=$(focused_monitor_geo)
  fi

  printf '%s' "$selection"
}

FREEZE_PID=""
freeze_screen() {
  if command -v hyprpicker >/dev/null 2>&1; then
    hyprpicker -r -z >/dev/null 2>&1 &
    FREEZE_PID=$!
    sleep .1
  fi
}

cleanup_freeze() {
  [[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" 2>/dev/null
}
trap cleanup_freeze EXIT

case "$MODE" in
region)
  freeze_screen
  SELECTION=$(pick)
  ;;
windows)
  freeze_screen
  SELECTION=$(get_rectangles | pick -r)
  ;;
fullscreen)
  SELECTION=$(focused_monitor_geo)
  ;;
smart | *)
  RECTS=$(get_rectangles)
  freeze_screen
  SELECTION=$(pick <<<"$RECTS")

  # Quick click (< 20px^2) snaps to matching window/monitor bounds
  if [[ $SELECTION =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] && ((BASH_REMATCH[3] * BASH_REMATCH[4] < 20)); then
    click_x=${BASH_REMATCH[1]}
    click_y=${BASH_REMATCH[2]}

    while IFS= read -r rect; do
      [[ $rect =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || continue
      rect_x=${BASH_REMATCH[1]}
      rect_y=${BASH_REMATCH[2]}
      rect_width=${BASH_REMATCH[3]}
      rect_height=${BASH_REMATCH[4]}

      if ((click_x >= rect_x && click_x < rect_x + rect_width && click_y >= rect_y && click_y < rect_y + rect_height)); then
        SELECTION="${rect_x},${rect_y} ${rect_width}x${rect_height}"
        break
      fi
    done <<<"$RECTS"
  fi
  ;;
esac

[[ -n $SELECTION ]] || exit 1

if [[ $MATCH_MONITOR == true ]]; then
  monitor=$(hyprctl monitors -j | jq -r --arg geo "$SELECTION" "${JQ_MONITOR_GEO} .[] | select(format_geo == \$geo) | .name" | head -1)
  if [[ -n $monitor ]]; then
    echo "monitor:$monitor"
    exit 0
  fi
fi

echo "$SELECTION"
