#!/bin/bash
## 60Hz (Battery Mode)

export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
export XDG_RUNTIME_DIR="/run/user/{{ .chezmoi.uid }}"

# Find active Hyprland instance by checking for live .socket.sock
for sig in $(ls -1t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null); do
    if [ -S "$XDG_RUNTIME_DIR/hypr/$sig/.socket.sock" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$sig"
        break
    fi
done

if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    MONITOR=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | test("eDP")).name' 2>/dev/null)
    if [ -n "$MONITOR" ]; then
        hyprctl eval "hl.monitor({ output = \"$MONITOR\", mode = \"1920x1200@60\", position = \"auto\", scale = \"1\" })"
    fi
fi
