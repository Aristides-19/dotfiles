export ELECTRON_OZONE_PLATFORM_HINT=wayland
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# iGPU Primary Renderer
export AQ_DRM_DEVICES=$(
    igpu=""
    dgpu=""
    for dev in /sys/class/drm/card[0-9]; do
        [ -e "$dev/device" ] || continue
        dev_id=$(cat "$dev/device/device" 2>/dev/null)
        if [ "$dev_id" = "0x1681" ]; then
            igpu="/dev/dri/$(basename "$dev")"
        elif [ "$dev_id" = "0x7480" ]; then
            dgpu="/dev/dri/$(basename "$dev")"
        fi
    done

    if [ -n "$igpu" ] && [ -n "$dgpu" ]; then
        echo "${igpu}:${dgpu}"
    elif [ -n "$igpu" ]; then
        echo "$igpu"
    else
        echo "$dgpu"
    fi
)

