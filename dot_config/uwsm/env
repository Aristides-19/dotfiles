export ELECTRON_OZONE_PLATFORM_HINT=wayland
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# iGPU Primary Renderer
export AQ_DRM_DEVICES=$(
    igpu=""
    dgpu=""
    for dev in /sys/class/drm/card[0-9]; do
        if [ -e "$dev/device" ]; then
            pci_id=$(basename "$(readlink -f "$dev/device")")
            if [ "$pci_id" = "0000:77:00.0" ]; then
                igpu="/dev/dri/$(basename "$dev")"
                elif [ "$pci_id" = "0000:03:00.0" ]; then
                dgpu="/dev/dri/$(basename "$dev")"
            fi
        fi
    done
    echo "${igpu}:${dgpu}"
)

